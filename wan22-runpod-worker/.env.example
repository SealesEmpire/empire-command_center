# WAN 2.2 RunPod worker — environment variables.
#
# NOTE: This is a RunPod *serverless* worker. In production these are set in the
# RunPod endpoint's "Environment Variables" UI, NOT loaded from a .env file.
# This file documents every variable the worker reads (see rp_handler.py /
# storage.py) so deploys are turnkey. Never commit real secrets.

# ── Paths (required) ─────────────────────────────────────────────────────────
# Model weights on the attached RunPod Network Volume. The worker returns
# MODEL_NOT_FOUND if this directory does not exist.
MODEL_DIR=/runpod-volume/models/Wan2.2-TI2V-5B
# Scratch dir for generation outputs before upload (created if missing).
OUTPUT_DIR=/runpod-volume/outputs
# Path to the cloned Wan2.2 repo inside the container image.
WAN_REPO_DIR=/app/Wan2.2

# ── Storage / S3-compatible (optional, strongly recommended) ─────────────────
# When all of S3_ENDPOINT_URL + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY +
# S3_BUCKET are set, finished clips are uploaded and a URL is returned. When
# unset, the worker returns a local_path only (fine for testing). Cloudflare R2
# is recommended.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# "auto" is correct for Cloudflare R2. For AWS S3 set the bucket's real region.
S3_REGION=auto
# Optional: if the bucket is public, returned URLs are built from this base
# instead of being signed.
S3_PUBLIC_BASE_URL=
# Signed URL TTL in seconds (default 7 days).
S3_SIGNED_URL_TTL=604800

# ── Generation defaults (optional) ───────────────────────────────────────────
# Per-job input can override these; the values below are the fallbacks.
WAN_TASK=ti2v-5B
WAN_SIZE=1280*704
# Hard ceiling (seconds) for the WAN subprocess before TIMEOUT is returned.
WAN_TIMEOUT_SECONDS=1800
