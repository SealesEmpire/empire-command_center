# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL, e.g. https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── RunPod ──────────────────────────────────────────────────────────────────
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Image worker (bot #2) serverless endpoint id — for generate_image.
RUNPOD_IMAGE_ENDPOINT_ID=
# Audio worker (bot #3) serverless endpoint id — for generate_audio.
RUNPOD_AUDIO_ENDPOINT_ID=

# ── Manager bot (Claude) ─────────────────────────────────────────────────────
# Anthropic API key — powers the conversational Manager that drives the pipeline.
ANTHROPIC_API_KEY=
# Optional: extra knowledge/instructions appended to the Manager's system prompt
# (brand voice, default prompt style, house rules). Plain text.
MANAGER_EXTRA_INSTRUCTIONS=

# ── Storage (R2 / S3) ───────────────────────────────────────────────────────
# Same bucket the worker uploads to. The orchestrator downloads clips by
# object_key to assemble the final video, then uploads the result here.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
# Optional: if your bucket is public, final URLs are built from this base.
S3_PUBLIC_BASE_URL=
# Signed URL TTL in seconds (default 7 days)
S3_SIGNED_URL_TTL=604800

# ── Orchestrator behavior ────────────────────────────────────────────────────
# Max generation attempts before a scene is marked failed.
MAX_GENERATION_ATTEMPTS=3

# ── Cost tracking (ledger) ───────────────────────────────────────────────────
# Used to estimate GPU spend per generation. Tune to your RunPod GPU price.
GPU_HOURLY_RATE_USD=0.8
IMAGE_COST_USD=0.01
AUDIO_COST_USD=0.02
